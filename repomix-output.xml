.audio-player-seek { display: grid; gap: 4px; }
.audio-player-seek input { width: 100%; height: 6px; margin: 0; accent-color: #e5a93c; cursor: pointer; }
.audio-player-time { display: flex; justify-content: space-between; color: #80756c; font: 11px/1 monospace; }
.audio-player-main-controls { justify-content: center; }
.audio-player-main-controls .audio-player-icon-button { color: #b9aa9b; background: transparent; }
.route-loader { display: grid; min-height: 60vh; place-items: center; color: rgba(245, 239, 230, .7); }
.spin { animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

@media (max-width: 700px) {
  .spa-app { display: block; }
  .studio-main { width: 100%; margin-left: 0; }
  .spa-sidebar { transform: translateX(-105%); position: fixed; width: min(86vw, 280px); min-height: 100vh; padding: 18px; border-right: 1px solid rgba(255, 255, 255, .07); border-bottom: 0; transition: transform .25s ease; }
  .spa-sidebar.is-open { transform: translateX(0); }
  .spa-sidebar nav { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .profile-link { margin-top: 10px; }
  .spa-content { padding: 24px 18px; }
  .studio-topbar { margin: 12px; flex-wrap: wrap; }
  .topbar-group { flex-wrap: wrap; }
  .topbar-right { width: 100%; justify-content: stretch; }
  .topbar-right > * { flex: 1; }
  .page-card { padding: 28px 22px; }
  .dashboard-grid { grid-template-columns: 1fr; }
  .studio-controls, .preset-grid { grid-template-columns: 1fr; }
  .scale-preview { align-items: flex-start; flex-direction: column; }
  .note-chips { justify-content: flex-start; }
  .harmonizer-controls { grid-template-columns: 1fr; }
}
